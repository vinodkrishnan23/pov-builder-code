# LLM — OpenAI-compatible (direct OpenAI, or Grove's proxy). Not read by
# Phase 0 (no node calls an LLM yet) — provided now so later phases don't
# need a config-shape change.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Optional. Set this if routing through Grove or another OpenAI-compatible base.
OPENAI_BASE_URL=

# GitHub — new.md: "source code belongs in the Git repository". ONE repo
# (GITHUB_REPO) holds everything — every POV's spec_architect contracts
# AND its generated application code. Each POV gets its own BRANCH, named
# "<email-slug>/<pov_name-slug>" — not pov_id (see tools/git_repo.py). The
# same (email, pov_name) always resolves to the same branch, so re-running
# a POV resumes/extends it rather than creating a duplicate.
GITHUB_ORG=
GITHUB_USERNAME=
GITHUB_TOKEN=
GITHUB_REPO=pov-builder

# MongoDB Atlas — persists every run's transcript + InitialPOVSpec (not a
# new.md requirement; a workspace-specific addition for traceability). Same
# cluster/URI convention as chat-agent/spec-architect in this workspace.
MONGODB_URI=
MONGODB_DB=pov_builder

LOG_LEVEL=INFO
